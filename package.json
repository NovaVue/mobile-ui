{
  "name": "zadmin",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "docs": "pnpm run --filter @apps/docs dev",
    "docs:build": "vitepress build docs",
    "component:dev": "pnpm run --filter @zve/components dev",
    "component:build": "pnpm run --filter @zve/components build",
    "request:dev": "pnpm run --filter @ztocwst/request dev",
    "request:build": "pnpm run --filter @ztocwst/request build",
    "mock:dev": "pnpm run --filter @ztocwst/mock dev",
    "mock:build": "pnpm run --filter @ztocwst/mock build",
    "cg": "pnpm changeset",
    "version": "pnpm changeset version",
    "publish": "pnpm publish -r",
    "check": "echo 'No check script needed'"
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=18.12.0"
  },
  "dependencies": {
    "vitepress": "^1.6.3"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^0.2.0",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.29.4",
    "@types/node": "^22.16.5",
    "@vitest/eslint-plugin": "^1.2.7",
    "conventional-changelog": "5.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-import-x": "^4.5.0",
    "globby": "^14.1.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "semver": "^7.6.3",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript-eslint>eslint": "^9.0.0",
        "@typescript-eslint/eslint-plugin>eslint": "^9.0.0",
        "@typescript-eslint/parser>eslint": "^9.0.0",
        "@typescript-eslint/type-utils>eslint": "^9.0.0",
        "@typescript-eslint/utils>eslint": "^9.0.0"
      }
    }
  }
