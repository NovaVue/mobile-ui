{
  "name": "@novavue/mobile-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run build:dev && npm run build:prod",
    "build:prod": "vue-tsc -b && vite build",
    "build:dev": "vue-tsc -b && vite build -m debelopment",
    "preview": "vite preview"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts"
    },
    "./*": "./*"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "tailwindcss": "^4.1.11",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitejs/plugin-vue-jsx": "^5.0.1",
    "@vue/tsconfig": "^0.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.8"
  }
}
